<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="45"
                android:endColor="#111111"
                android:startColor="#5E35B1" />
        </shape>
    </item>
    <item android:left="22dp" android:top="22dp">
        <shape android:shape="oval">
            <size android:width="52dp" android:height="52dp" />
            <solid android:color="#55FFFFFF" />
        </shape>
    </item>
    <item android:left="22dp" android:bottom="22dp" android:gravity="start|bottom">
        <shape android:shape="rectangle">
            <size android:width="120dp" android:height="36dp" />
            <corners android:radius="12dp" />
            <solid android:color="#66FFFFFF" />
        </shape>
    </item>
</layer-list>
